# Only the Go module and its embedded assets need to reach the build context.

# Version control
.git
.gitignore

# Secrets must never be baked into the image; they are passed at runtime
# through docker-compose env_file.
.env
.env.local
.env.*.local

# Build output
bin/

# Documentation and tooling
*.md
docs/
Makefile
.claude/
.superpowers/

# Separate repository (LaTeX CV)
personal-cv/

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# OS / editor noise
.DS_Store
Thumbs.db
*.log
