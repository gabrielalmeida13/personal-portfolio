# Every variable is optional. Without a group, that integration degrades:
# the record rests, or the repositories panel points at GitHub instead of
# listing repos. Nothing fails to start.

# Spotify — drives the record
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# GitHub — pinned repositories
GITHUB_TOKEN=
GITHUB_USERNAME=

# Overrides for the defaults compiled into the binary
PORT=3000
CONTACT_EMAIL=
LINKEDIN_URL=
GITHUB_URL=
